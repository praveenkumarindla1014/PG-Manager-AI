# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB — local install, Atlas, or leave unreachable to use the built-in embedded DB
MONGODB_URI=mongodb://127.0.0.1:27017/pg_management_system

# JWT (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d

# AI — primary provider (any OpenAI-compatible API). Defaults to OpenRouter for non-OpenAI keys.
AI_API_KEY=sk-or-v1-...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# AI — automatic backup: Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# PG details used in reminders, notices and payment info
PG_NAME=SmartPG
PG_UPI_ID=smartpg@upi
